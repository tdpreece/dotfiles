# search
alias agp='ag --python'

alias vimqf="vim - -c 'cb | cw'"  # loads current buffer into quickfix then opens quickfix

alias ag-fintech='ag --nonumbers fintech CODEOWNERS | awk "{print $1}" | sed -E "s/(.*)/\.\1/p" | xargs ag --python'

agvim() {
    ag --vimgrep $@ | vimqf
}

agvim-py() {
    agvim --python $@
}

agvim-py-no-tests-or-migrations() {
    agvim-py --python --ignore-dir={migrations,tests} --ignore=tests* $@
}

agvim-py-tests-only() {
    agvim -G '.*tests.*.py' $@
}

agvim-py-migrations-only() {
    agvim -G '.*migrations.*.py' $@
}

