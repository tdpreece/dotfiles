# git
alias ga='git add'
alias gaa='git add -A'
alias gb='git branch'
alias gco='git checkout'
alias gcb='git checkout -b'
alias gcl='git clone'
alias gd='git diff'
alias gdc='git diff --cached'
gdm() {
    branch_name=$(git branch | grep \* | cut -d ' ' -f2)
    git diff master...$branch_name $1
}
alias gl='git log --pretty=format:"%h - %an, %ad : %s" "$@"'
alias gcm='git commit -m'
alias gcz='git cz'  # commitizen
alias gcma='git commit -a '
alias gm='git merge'
gpush() {
    branch_name=$(git branch)
    if [[ ${branch_name} == '* master' ]]; then
    cat << EOF
    *******************************
    *   On master, can't push     *
    *******************************
EOF
        return
    fi
    git push "$@"
}
gpushf() {
   # In short, --force-with-lease is a kind-of client side optimistic
   # concurrency model that checks your local ref to the remote againsit
   # the remove and # if they don't match, it doesn't let you push.
   # You need to pull # changes made in the interim and sort out any conflicts before
   # pushing. https://developer.atlassian.com/blog/2015/04/force-with-lease/
   gpush --force-with-lease "$@"
}
alias gpull='git pull'
alias gra='git remote add'
alias grau='git remote add upstream'
alias grb='git rebase -i'
alias grl='git remote -v'
alias grr='git remote rm'
alias gs='git status'
alias gsu='git submodule update'
alias gsui='git submodule update --init'
alias git_delete_remote_branch='git push origin --delete'
alias git_delete_merged_branches='git branch --merged | egrep -v "(^\* master)" | xargs git branch -d'
alias git_list_merged_branches='git branch --merged | egrep -v "(^\* master)"'
gfmr() {
    # Git Find Merge Requeset
    # Find merge request associated with a given commit ID.
    # e.g. gfmr 127398e2
    git log $1..HEAD --ancestry-path --merges --reverse | perl -ne \
        '$a = "" if /^commit/; $a .= $_; if (/^    See merge request/) { print $a; exit }'
}
git_last_changed() {
    git for-each-ref --sort=-committerdate --count=$1 --format='%(refname:short)' refs/heads/
}
git_search() {
 # Find merge request associated with a given commit ID.
     git log $1..HEAD --ancestry-path --merges --reverse | perl -ne '$a += 1 if /^commit/; exit if $a >= 2; print'
}
pylint_differences() {
    branch_name=$(git branch | grep \* | cut -d ' ' -f2)
    git log --pretty="" --name-only  "${branch_name}"...master | ag ".*.py$" | xargs pylint
}

