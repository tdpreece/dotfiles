# Django
django_find_in_urls() {
    grep -r --include="urls.py" $1 *
}

django_find_links_to() {
    local view_name=$1
    ag --html "${view_name}" | grep url
    ag --py "${view_name}" | grep reverse
}

# wip
django_find_links_to_vim() {
    ag --html xero | grep url | awk '{ print $1}' | sed -E -n -e 's/([^:]+):([0-9]+).*/\2 \1/p' | xargs vim
}

django_get_context_used_in_template() {
    # If use with wildcard need to use quotes, e.g.
    # get_context_used_in_template "case_study*"
    grep --no-filename -o '{{[^}]*}}' $1 | sed 's|{{[ ]*\([^}|]*\).*}}|\1|' | sort | uniq
}

find_function() {
    grep -r --include="*.py" "def $1(.*):"
}

get_host_file_name() {
    echo $(hostname):$(pwd)/$1
}

whats_on_port() {
    local port=$1
    set -x
    lsof -i :${port}
    netstat -tulpn | grep ${port}
    set +x
}

# plantml https://plantuml.com/starting
plantml_start() {
    docker run -d -p 1913:8080 plantuml/plantuml-server:jetty
    echo "Open http://localhost:1913/"
}

plantml_stop() {
   docker ps -a -q --filter ancestor=plantuml/plantuml-server:jetty | xargs docker stop
}

# process_stats
ps_stats() {
    echo "********************************"
    local pid=$1
    ps uwww -p "${pid}"
    echo ""
    grep VmSwap "/proc/${pid}/status"
    echo ""
    echo "
    RSS: resident set size, the non-swapped physical memory that a task has used (in kiloBytes). (alias rssize, rsz).
         = binary(part loaded) + stack (not swapped) + heap (not swapped)
    VSZ: virtual memory size of the process in KiB (1024-byte units)
         = binary + shared libraries + stack + heap
    "
    echo "********************************"
}


cat_cmd() {
